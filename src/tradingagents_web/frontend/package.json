    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "i18next": "^24.0.0",
    "lucide-react": "^0.500.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "react-markdown": "^10.0.0",
    "react-router-dom": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.0"
