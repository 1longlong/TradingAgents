# Enterprise env file (secrets) and generated run reports
.env.enterprise
reports/

# Token-benchmark artifacts. Only reviewed, de-identified reports are
# versionable: experiment.json, notes.md, and the summary set written by
# ``scripts/token_benchmark.py`` (which records telemetry locations as paths
# relative to the experiment directory, never host absolute paths). Raw run
# evidence (runs/, cases/), caches, and the environment-specific code_state.json
# stay local — they are large, machine-specific, and not needed to read a report.
token_benchmarks/*/runs/
token_benchmarks/*/cases/
token_benchmarks/*/code_state.json
token_benchmarks/*/summary_index.json

# One-command measurements (scripts/run_token_benchmark.sh). Every invocation
# writes a fresh timestamped archive here; these are local evidence, so they are
# never tracked and a new measurement never dirties the working tree.
token_benchmarks/measurements/

# Plan C3: the frozen-commit pointer is written after the commit it names
# (a commit cannot contain its own hash), so it is release metadata, not source.
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v2/c3/FROZEN_COMMIT
# The rest of the post-commit release record. All of it names the final commit
# or is derived after it, so none of it can live inside that commit; keeping it
# ignored is what lets the certified working tree be clean. The tracked
# authority is c3/code_freeze.txt (the fingerprint), c3/RELEASE_SEAL.sha256 and
# MANIFEST.sha256, and scripts/c3_verify_final_freeze.py checks all of it.
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v2/c3/FREEZE_RECORD.json
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v2/c3/FREEZE_HISTORY.jsonl
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v2/c3/FINAL_FREEZE_REPORT.md

# V3 batch: run-time artefacts written by the harness into the registered spec
# directories. They are excluded from the code fingerprint and from MANIFEST,
# so ignoring them locally is what lets a paid run leave the certified tree
# clean. Only run-time output is listed; specs, protocol and baseline are
# tracked.
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/specs/*/code_state.json
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/specs/*/runs/
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/specs/*/summary.json
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/specs/*/summary.csv
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/specs/*/summary.md
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/specs/*/summary_agents.csv
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/specs/*/effective_config.json
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/specs/*/runner_report.json
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/specs/*/refusal.json
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/c3/FROZEN_COMMIT
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/c3/FREEZE_RECORD.json
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/c3/FREEZE_HISTORY.jsonl
token_benchmarks/live_pilot_2x2/cand01_batch_16run_v3/c3/FINAL_FREEZE_REPORT.md
