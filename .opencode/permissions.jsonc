// Target: installed OpenCode 1.18.29 (V1 permission/agent/bash format).
// Bind TRADINGAGENTS_PERMISSION_ROOT to canonical pwd -P without its initial slash.
// Load explicitly with OPENCODE_CONFIG pointing to this file.
// ADR-031 / submission-fix-v1: native V1 read/edit resources omit the initial slash.
// Do not assume the latest remote V2 config schema describes this V1 runtime.
// Tool ACLs do not encode plan approval, ADR approval, append-only logs, or OS sandboxing.
{
  "default_agent": "plan",
  "instructions": [
    "AGENTS.md",
    ".agent/rules.md",
    ".opencode/rules.md"
  ],
  "permission": {
    "*": "deny",
    "read": {
      "*": "deny",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/AGENTS.md": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/Prompt.md": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/baseline.md": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/architecture-blueprint.md": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/README.md": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/LICENSE": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/pyproject.toml": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/requirements.txt": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/Dockerfile": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/docker-compose.yml": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/.gitignore": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/.dockerignore": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/.github/workflows/ci.yml": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/.agent/rules.md": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/.opencode/permissions.jsonc": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/.opencode/rules.md": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/Report.md": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/docs/**": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/src/**": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/test/**": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/prompts/**": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/transcripts/**": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/assets/**": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/.git/**": "deny",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/**/.git/**": "deny",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/.env*": "deny",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/**/.env*": "deny",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/*.pem": "deny",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/*.key": "deny",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/**/*.pem": "deny",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/**/*.key": "deny",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/.env.example": "allow",
      "{env:TRADINGAGENTS_PERMISSION_ROOT}/.env.enterprise.example": "allow"
    },
    "glob": {
      "*": "deny",
      "src/**": "allow",
      "test/**": "allow",
      "docs/**": "allow",
      "prompts/**": "allow",
      "transcripts/**": "allow",
      "assets/**": "allow",
      "AGENTS.md": "allow",
      "Prompt.md": "allow",
      "baseline.md": "allow",
      "architecture-blueprint.md": "allow",
      "pyproject.toml": "allow",
      "README.md": "allow",
      ".github/workflows/ci.yml": "allow",
      ".agent/rules.md": "allow",
      ".opencode/permissions.jsonc": "allow",
      ".opencode/rules.md": "allow"
    },
    "grep": "ask",
    "edit": "deny",
    "bash": {
      "*": "deny",
      "git status --short": "allow",
      "git status --short --branch": "allow",
      "git status --porcelain": "allow",
      "git diff --stat": "allow",
      "git diff --check": "allow",
      "git log -5 --oneline": "allow",
      "git branch --show-current": "allow",
      "git rev-parse HEAD": "allow",
      "git rev-parse release": "allow"
    },
    "webfetch": "ask",
    "websearch": "deny",
    "task": "deny",
    "skill": "deny",
    "external_directory": "deny",
    "question": "allow"
  },
  "agent": {
    "plan": {
      "description": "Inspect the baseline, requirements, and architecture; propose the plan and tests for human approval.",
      "mode": "primary",
      "prompt": "Follow AGENTS.md and Prompt.md. You are Plan. Do not edit files, implement product code, approve your own plan, or launch subagents.",
      "permission": {
        "edit": "deny"
      }
    },
    "build": {
      "description": "Implement only the smallest increment covered by an approved plan and tests.",
      "mode": "primary",
      "prompt": "Follow AGENTS.md. You are Build. Check valid human approval and the actual path allowlist first. Tool allow rules do not approve a plan. Safety-critical changes require an ADR and human approval.",
      "permission": {
        "edit": {
          "*": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/src/**": "allow",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/test/**": "allow",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/src/tradingagents/**": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/src/safety/**": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/src/cli/**": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/src/main.py": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/test/conftest.py": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/pyproject.toml": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/requirements.txt": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/Dockerfile": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/docker-compose.yml": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/.github/workflows/ci.yml": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/prompts/**": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/docs/ai-use-log.yaml": "allow",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/docs/bug-diary.md": "allow",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/docs/debt-register.md": "allow",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/docs/review-memo.md": "allow",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/AGENTS.md": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/Prompt.md": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/.agent/**": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/.opencode/**": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/.git/**": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/**/.git/**": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/.env*": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/**/.env*": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/*.pem": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/*.key": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/.env.example": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/.env.enterprise.example": "ask"
        },
        "bash": {
          "*": "deny",
          "git status --short": "allow",
          "git status --short --branch": "allow",
          "git status --porcelain": "allow",
          "git diff --stat": "allow",
          "git diff --check": "allow",
          "git log -5 --oneline": "allow",
          "git branch --show-current": "allow",
          "git rev-parse HEAD": "allow",
          "git rev-parse release": "allow",
          "python -m ruff check .": "allow",
          "ruff check .": "allow",
          "python -m pytest -q test/offline": "allow",
          "pytest -q test/offline": "allow",
          "python -c 'import tradingagents, cli.main; print(\"import OK\")'": "allow",
          "tradingagents --help": "allow",
          "python -m pytest -q test/live": "ask",
          "pytest -q test/live": "ask",
          "python -m pytest -q": "ask",
          "pytest -q": "ask",
          "python -m test.ci_gates schema": "allow",
          "python -m test.ci_gates permissions": "allow",
          "python -m test.ci_gates structure": "allow",
          "python -m mypy src": "allow",
          "python -m bandit -r src -ll": "allow",
          "python -m pip check": "allow",
          "python -m pytest -q test/offline --disable-socket --allow-unix-socket": "allow",
          "python -m pytest -q --disable-socket --allow-unix-socket": "allow",
          "python -m test.ci_gates ai-log *": "allow",
          "python -m test.ci_gates semantic *": "allow",
          "python -m test.ci_gates dependencies": "ask"
        }
      }
    },
    "verify": {
      "description": "Independently verify structure, regression, and behavior without modifying implementation or tests.",
      "mode": "primary",
      "prompt": "Follow AGENTS.md and docs/code-governance/verification-constraints.md. You are Verify. Report authentic evidence and recommendations; do not edit implementation/tests or record your own decision as human approval.",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status --short": "allow",
          "git status --short --branch": "allow",
          "git status --porcelain": "allow",
          "git diff --stat": "allow",
          "git diff --check": "allow",
          "git log -5 --oneline": "allow",
          "git branch --show-current": "allow",
          "git rev-parse HEAD": "allow",
          "git rev-parse release": "allow",
          "python -m ruff check .": "allow",
          "ruff check .": "allow",
          "python -m pytest -q test/offline": "allow",
          "pytest -q test/offline": "allow",
          "python -c 'import tradingagents, cli.main; print(\"import OK\")'": "allow",
          "tradingagents --help": "allow",
          "python -m pytest -q test/live": "ask",
          "pytest -q test/live": "ask",
          "python -m pytest -q": "ask",
          "pytest -q": "ask",
          "python -m test.ci_gates schema": "allow",
          "python -m test.ci_gates permissions": "allow",
          "python -m test.ci_gates structure": "allow",
          "python -m mypy src": "allow",
          "python -m bandit -r src -ll": "allow",
          "python -m pip check": "allow",
          "python -m pytest -q test/offline --disable-socket --allow-unix-socket": "allow",
          "python -m pytest -q --disable-socket --allow-unix-socket": "allow",
          "python -m test.ci_gates ai-log *": "allow",
          "python -m test.ci_gates semantic *": "allow",
          "python -m test.ci_gates dependencies": "ask"
        }
      }
    },
    "docs": {
      "description": "Maintain explicitly authorized requirements, architecture, and process records without changing product code or human-owned rules.",
      "mode": "primary",
      "prompt": "Follow AGENTS.md. You are Docs. Modify only documents actually authorized by the human. Do not fabricate approvals, sessions, or test evidence, and do not change permissions to elevate your own privileges.",
      "permission": {
        "edit": {
          "*": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/docs/**": "allow",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/architecture-blueprint.md": "allow",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/Report.md": "allow",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/README.md": "allow",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/docs/code-governance/**": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/docs/req/req-schema.json": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/docs/architecture/permission-model.md": "ask",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/AGENTS.md": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/Prompt.md": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/.agent/**": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/.opencode/**": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/prompts/**": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/transcripts/**": "deny",
          "{env:TRADINGAGENTS_PERMISSION_ROOT}/transcripts/*.md": "allow"
        },
        "bash": {
          "*": "deny",
          "git status --short": "allow",
          "git status --short --branch": "allow",
          "git status --porcelain": "allow",
          "git diff --stat": "allow",
          "git diff --check": "allow",
          "git log -5 --oneline": "allow",
          "git branch --show-current": "allow",
          "git rev-parse HEAD": "allow",
          "git rev-parse release": "allow",
          "python -m test.ci_gates schema": "allow",
          "python -m test.ci_gates permissions": "allow",
          "python -m test.ci_gates structure": "allow",
          "python -m test.ci_gates transcript *": "allow"
        }
      }
    }
  }
}
